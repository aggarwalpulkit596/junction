 "captions": [
  {
   "line": "L01",
   "text": "Twenty trains. Four robots.",
   "start": 0.82,
   "end": 2.94
  },
  {
   "line": "L01",
   "text": "One railway across Europe.",
   "start": 3.1,
   "end": 4.8
  },
  {
   "line": "L02",
   "text": "But one of them\u2026",
   "start": 6.12,
   "end": 7.46
  },
  {
   "line": "L02B",
   "text": "is a saboteur.",
   "start": 8.42,
   "end": 10.2
  },
  {
   "line": "L03",
   "text": "Walk the rails. Claim the routes.",
   "start": 11.52,
   "end": 13.58
  },
  {
   "line": "L04",
   "text": "Solve station tasks for locomotives\u2026",
   "start": 14.92,
   "end": 17.36
  },
  {
   "line": "L04",
   "text": "or check a robot\u2019s alibi.",
   "start": 17.38,
   "end": 19.62
  },
  {
   "line": "L05",
   "text": "Then the signals fail.",
   "start": 21.12,
   "end": 22.86
  },
  {
   "line": "L06",
   "text": "A route goes dark.",
   "start": 23.92,
   "end": 25.02
  },
  {
   "line": "L06",
   "text": "And two robots were seen nearby.",
   "start": 25.04,
   "end": 27.38
  },
  {
   "line": "L07",
   "text": "You get one emergency meeting. One vote.",
   "start": 29.52,
   "end": 32.56
  },
  {
   "line": "L08",
   "text": "Choose wrong\u2026",
   "start": 42.52,
   "end": 43.72
  },
  {
   "line": "L08B",
   "text": "and the saboteur gets away with it.",
   "start": 44.32,
   "end": 46.82
  },
  {
   "line": "L09",
   "text": "Junction: Saboteur Express.",
   "start": 47.22,
   "end": 49.26
  },
  {
   "line": "L10",
   "text": "Pick a Quick game. Trust no robot.",
   "start": 50.12,
   "end": 52.56
  }
 ],
